# Base URL of the dev site under test.
NTP_BASE_URL=https://web.askdev.grundclock.com

# Base URL of the internal Go API, reachable over Tailscale.
# Used to mint test sessions via the CreateTestSession RPC.
# Must include the /int/rpc prefix the ConnectRPC services mount under,
# and have no trailing slash. The harness appends
# /ntppool.auth.v1.AuthService/CreateTestSession to this value.
NTP_INTERNAL_API_URL=http://api-internal.example.ts.net/int/rpc

# Bearer key authorizing the CreateTestSession RPC.
# Provision via the Go API with the test-session-api capability (see README).
# Dev only: the mint RPC refuses to run outside the devel environment.
NTP_TEST_SESSION_KEY=

# IP address used by the add-server test (e2e/tests/server.spec.ts).
# Defaults to an RFC 5737 documentation address. Adding a server requires the
# account to have the `can_add_servers` permission (a brand-new account must
# verify its existing servers first) AND a routable IP the Go API can resolve
# / accept; an RFC 5737 address may be rejected. The add and delete/cancel
# tests skip gracefully when the precondition isn't met.
NTP_SERVER_TEST_IP=192.0.2.123

# Optional: IP (or numeric id) of an EXISTING server in the test account, used
# by the scheduled-delete / cancel test (§8a) when adding a fresh server isn't
# possible. When unset, that test falls back to a server added earlier in the
# same serial run, and skips if none is available.
# NTP_EXISTING_SERVER_IP=

# Public scores/graph test server IP (used by e2e/tests/scores.spec.ts).
# Must be a real server that exists on the dev site: the public scores/graph
# pages do a CAPI get_server lookup and return 404 for an unknown IP, so an
# RFC 5737 documentation address will NOT work here — it has to be a server
# that is actually in the database. The default is Google's public NTP server,
# which the dev site uses in its own cache-busting example (CLAUDE.local.md).
# Set this to a known-good dev server IP if the default is ever removed.
NTP_SCORES_TEST_IP=216.239.35.4

# Read-only Postgres URL for the grey-box DB verification layer (e2e/lib/db.ts).
# Used to assert side effects with no UI surface: "email sent", "audit log
# written", "invite expiry", "sessions swept". Setup still goes through the API;
# these queries are assertion-only.
#
# MUST be a READ-ONLY role (e.g. ntp-test-ro, or a read-only Vault dynamic-creds
# path) so the harness credential cannot mutate anything. The module issues only
# SELECTs, but the role is the real safety boundary.
#
# assertDevelDatabase() additionally refuses any database that is not the devel
# DB: it requires the database name to be `askntp` AND the system_settings
# `environment` value to read `devel`, mirroring the Go API's devel guard. Point
# this at prod and every query throws.
NTP_TEST_DB_URL=postgres://ntp-test-ro:pass@host:5432/askntp
