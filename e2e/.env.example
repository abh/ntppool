# Base URL of the public dev site under test (scores, graphs, i18n pages).
NTP_BASE_URL=https://web.askdev.grundclock.com

# Base URL of the authenticated manage app. This is a SEPARATE Combust site
# from NTP_BASE_URL (different host/ingress); all /manage flows and the login
# session cookie live here. The 'manage' Playwright project runs against this.
NTP_MANAGE_URL=https://manage.askdev.grundclock.com

# Base URL of the internal Go API, reachable over Tailscale.
# Used to mint test sessions and manage isolated server fixtures.
# Must include the /int/rpc prefix the ConnectRPC services mount under,
# and have no trailing slash. The harness appends the AuthService procedure.
NTP_INTERNAL_API_URL=http://api-internal.example.ts.net/int/rpc

# Bearer key authorizing CreateTestSession and the server fixture RPCs.
# Provision via the Go API with the test-session-api capability (see README).
# Dev only: these RPCs refuse to run outside the devel environment.
NTP_TEST_SESSION_KEY=

# Public scores/graph test server IP (used by e2e/tests/scores.spec.ts).
# Must be a real server that exists on the dev site: the public scores/graph
# pages do a CAPI get_server lookup and return 404 for an unknown IP, so an
# RFC 5737 documentation address will NOT work here — it has to be a server
# that is actually in the database. The default is Google's public NTP server,
# which the dev site uses in its own cache-busting example (CLAUDE.local.md).
# Set this to a known-good dev server IP if the default is ever removed.
NTP_SCORES_TEST_IP=216.239.35.4

# Note: the harness no longer uses a direct DB verification layer. Side effects
# with no UI/API surface (email rows, audit-log rows, invite expiry) are not
# asserted, by design — the test DB role must stay read-only by contract and we
# don't depend on it. Verify such effects through the API/UI if a surface exists.
