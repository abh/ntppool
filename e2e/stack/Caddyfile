{
	auto_https disable_redirects
}

web.ntppool.test, manage.ntppool.test {
	tls internal
	reverse_proxy ntppool:8299 {
		header_up X-Forwarded-Proto https
	}
}

# stripe-gw: the stub or the real service, by STRIPE_MODE (stub|real), which
# up exports and CI's proxy step sets. Caddy substitutes {$STRIPE_MODE}
# before parsing. A mode that names no file is only logged ("File to import
# not found") and leaves this site empty, so compose (${STRIPE_MODE:?}) and
# the CI step check the value instead.
# CI has no network aliases: there the app reaches this site as http://proxy.
http://stripe-gw, http://proxy {
	import stripe-{$STRIPE_MODE}.caddy
}
