#!/bin/sh
# Seeds the stack's database. Usage: seed [all|setup|sql|publish|service-key]
#
# Compose runs `all` inside the pinned API image (service `seed`, as root).
# CI has no root in that image, so it runs `setup` and `publish` there and
# `sql` in an image that ships psql.
#
# `service-key` (real-Stripe stacks only, not part of `all`) creates the
# stripe-gw service and writes its API key to $APIBIN/stripe-gw-api-key.
#
# Environment: STACK_DIR (default /stack) holds seed.sql, APIBIN (default
# /apibin) receives the api binary.
set -eu

STACK_DIR=${STACK_DIR:-/stack}
APIBIN=${APIBIN:-/apibin}

setup() {
    /app/api setup
}

sql() {
    # Without psql (the API image), install it; needs root and network access
    # to the Alpine mirrors.
    if ! command -v psql >/dev/null 2>&1; then
        apk add --no-cache postgresql18-client >/dev/null
    fi

    psql "$DATABASE_URI" -v ON_ERROR_STOP=1 -X -q -f "$STACK_DIR/seed.sql"

    # The e2e fixture tables and the run_id column only exist when the
    # migrations ran with deployment_mode=devel.
    ok=$(psql "$DATABASE_URI" -v ON_ERROR_STOP=1 -X -At -c "
      SELECT to_regclass('public.e2e_fixtures') IS NOT NULL
         AND EXISTS (SELECT 1 FROM information_schema.columns
                     WHERE table_schema = 'public'
                       AND table_name = 'e2e_fixtures'
                       AND column_name = 'run_id')")
    if [ "$ok" != "t" ]; then
        echo "e2e fixture tables missing: is deployment_mode=devel set for seed?" >&2
        exit 1
    fi
}

publish() {
    cp /app/api "$APIBIN/api"
}

# The key is printed once, indented, on the line after the marker; it is
# never echoed here. 0644: the volume is private to the stack, and
# stripe-gw runs as another user.
service_key() {
    out=$(/app/api service create e2e-stripe-gw --type stripe-gw)
    key=$(printf '%s\n' "$out" | awk '
        found { gsub(/^[ \t]+|[ \t]+$/, ""); print; exit }
        $0 == "API Key (save this - shown only once!):" { found = 1 }')
    if [ -z "$key" ]; then
        echo "api service create printed no API key after its marker line" >&2
        exit 1
    fi
    (umask 022 && printf '%s\n' "$key" >"$APIBIN/stripe-gw-api-key")
}

case ${1:-all} in
all)
    setup
    sql
    publish
    ;;
setup) setup ;;
sql) sql ;;
publish) publish ;;
service-key) service_key ;;
*)
    echo "usage: seed [all|setup|sql|publish|service-key]" >&2
    exit 2
    ;;
esac
echo "seed ${1:-all} complete"
