#!/bin/sh
# Cancels the Stripe test-mode subscriptions e2e stacks left behind.
#
#   stripe-sweep --stack <id>        one stack: its database's customers,
#                                    plus metadata e2e_stack=<id>
#   stripe-sweep --older-than <N>d   every e2e_stack-tagged subscription
#                                    created more than N days ago
#
# Runs in alpine: the compose service stripe-sweep (e2e/stack/down) and the
# CI sweep steps. Environment: STRIPE_SECRET_KEY; DATABASE_URI (--stack).
#
# A subscription is live unless canceled or incomplete_expired (terminal;
# Stripe won't cancel those). Stripe search lags about a minute, so the
# stack's database is the first source for --stack; search catches a
# subscription whose customer never reached the database.
set -eu

usage() {
    echo "usage: stripe-sweep --stack <id> | --older-than <N>d" >&2
    exit 2
}

[ $# -eq 2 ] || usage
mode=$1
arg=$2
case $mode in
--stack) [ -n "$arg" ] || usage ;;
--older-than)
    days=${arg%d}
    case $days in '' | *[!0-9]*) usage ;; esac
    ;;
*) usage ;;
esac

: "${STRIPE_SECRET_KEY:?STRIPE_SECRET_KEY is not set}"

if ! command -v curl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1 ||
    ! command -v psql >/dev/null 2>&1; then
    apk add --no-cache curl jq postgresql17-client >/dev/null
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# Every call checks its own result: set -e does not apply inside a function
# called from an || list.

# stripe_api METHOD PATH [curl args]: the response body on stdout; a non-2xx
# answer prints the body on stderr and fails. The key goes to curl on stdin,
# never in argv.
stripe_api() {
    method=$1
    path=$2
    shift 2
    printf 'user = "%s:"\n' "$STRIPE_SECRET_KEY" |
        curl -sS --fail-with-body -K - -X "$method" "https://api.stripe.com/v1$path" "$@" \
            >"$work/body" || {
        cat "$work/body" >&2
        return 1
    }
    cat "$work/body"
}

live='.data[] | select(.status != "canceled" and .status != "incomplete_expired") | .id'

# search QUERY: live subscription ids matching a Stripe search query.
search() {
    page=""
    while :; do
        if [ -n "$page" ]; then
            res=$(stripe_api GET /subscriptions/search -G --data-urlencode "query=$1" -d limit=100 --data-urlencode "page=$page") || return 1
        else
            res=$(stripe_api GET /subscriptions/search -G --data-urlencode "query=$1" -d limit=100) || return 1
        fi
        printf '%s\n' "$res" | jq -r "$live"
        [ "$(printf '%s\n' "$res" | jq -r .has_more)" = true ] || break
        page=$(printf '%s\n' "$res" | jq -r .next_page)
    done
}

# customer_subscriptions CUSTOMER: the customer's live subscription ids.
customer_subscriptions() {
    after=""
    while :; do
        res=$(stripe_api GET /subscriptions -G -d "customer=$1" -d status=all -d limit=100 ${after:+-d "starting_after=$after"}) || return 1
        printf '%s\n' "$res" | jq -r "$live"
        [ "$(printf '%s\n' "$res" | jq -r .has_more)" = true ] || break
        after=$(printf '%s\n' "$res" | jq -r '.data[-1].id')
    done
}

incomplete=""
: >"$work/ids"
case $mode in
--stack)
    if customers=$(psql "${DATABASE_URI:?DATABASE_URI is not set}" -X -A -t -v ON_ERROR_STOP=1 -c \
        "SELECT DISTINCT stripe_customer_id FROM accounts WHERE stripe_customer_id <> ''"); then
        for cus in $customers; do
            if ! customer_subscriptions "$cus" >>"$work/ids"; then
                echo "listing the subscriptions of $cus failed" >&2
                incomplete=1
            fi
        done
    else
        echo "the stack database is unreachable: searching by metadata only, which can miss a subscription from the last minute" >&2
        incomplete=1
    fi
    if ! search "metadata['e2e_stack']:'$arg'" >>"$work/ids"; then
        echo "the metadata search failed" >&2
        incomplete=1
    fi
    ;;
--older-than)
    cutoff=$(($(date -u +%s) - days * 86400))
    if ! search "-metadata['e2e_stack']:null AND -status:'canceled' AND created<$cutoff" >>"$work/ids"; then
        echo "the metadata search failed" >&2
        incomplete=1
    fi
    ;;
esac

failed=0
cancelled=0
for id in $(sort -u "$work/ids"); do
    if stripe_api DELETE "/subscriptions/$id" >/dev/null; then
        echo "cancelled $id"
        cancelled=$((cancelled + 1))
        continue
    fi
    # Ended between the listing and the cancel: nothing left to do.
    status=$(stripe_api GET "/subscriptions/$id" | jq -r .status) || status=""
    case $status in
    canceled | incomplete_expired) echo "$id is already $status" ;;
    *)
        echo "could not cancel $id (status: ${status:-unknown})" >&2
        failed=$((failed + 1))
        ;;
    esac
done

echo "stripe-sweep $mode $arg: cancelled $cancelled, failed $failed"
if [ "$failed" -gt 0 ] || [ -n "$incomplete" ]; then
    exit 1
fi
